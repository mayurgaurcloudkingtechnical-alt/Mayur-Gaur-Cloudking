# ==============================================================================
# SOFTLAB GLOBAL — Environment Variables Configuration
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SOFTLAB GLOBAL"
NEXT_PUBLIC_SUPPORT_PHONE="9194085890"
NEXT_PUBLIC_SUPPORT_EMAIL="info@softlabglobal.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/softlab_global?schema=public"
# Direct connection for Prisma migrations (if using PgBouncer / Connection Pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/softlab_global?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_to_a_cryptographically_secure_random_string_32_chars_min"
NEXTAUTH_URL="http://localhost:3000"
# Session duration in seconds (default: 8 hours = 28800)
SESSION_MAX_AGE=28800

# ------------------------------------------------------------------------------
# 4. CACHE & BACKGROUND JOBS (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN="" # Required only for Upstash Redis

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay / Abstract Provider)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="RAZORPAY"
# Public Key used in client checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourRazorpayKeyIdHere"
# Private Key used server-side only
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
# Webhook Secret used to verify incoming Razorpay webhook HMAC signatures
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# ------------------------------------------------------------------------------
# 6. SECURE CLOUD STORAGE (AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Provider switch: 'S3' | 'R2'
STORAGE_PROVIDER="R2"
STORAGE_ACCESS_KEY="YourStorageAccessKey"
STORAGE_SECRET_KEY="YourStorageSecretKey"
STORAGE_BUCKET="softlab-global-assets"
STORAGE_REGION="auto"
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# For AWS S3: https://s3.<region>.amazonaws.com (or omit for default AWS SDK routing)
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_PUBLIC_DOMAIN="" # Optional CDN domain if caching public avatars

# ------------------------------------------------------------------------------
# 7. SECURE VIDEO STREAMING (Bunny.net Stream / Cloudflare Stream)
# ------------------------------------------------------------------------------
VIDEO_PROVIDER="BUNNY_STREAM"
BUNNY_STREAM_LIBRARY_ID="12345"
BUNNY_STREAM_API_KEY="YourBunnyApiKey"
# Secret used for creating SHA-256 signed playback tokens with expiration
BUNNY_STREAM_TOKEN_SECURITY_KEY="YourBunnyTokenAuthKey"
BUNNY_STREAM_HOSTNAME="video.softlabglobal.com"

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL (Resend / SMTP Nodemailer)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="RESEND"
RESEND_API_KEY="re_YourResendApiKeyHere"
EMAIL_FROM="SOFTLAB GLOBAL <admissions@softlabglobal.com>"

# SMTP Fallback configuration (if EMAIL_PROVIDER="SMTP")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ------------------------------------------------------------------------------
# 9. BUSINESS INFORMATION (Institutional Identity)
# ------------------------------------------------------------------------------
COMPANY_NAME="SOFTLAB GLOBAL"
COMPANY_LEGAL_ADDRESS="Patrika Chauraha, 13/11/8G, Tashkent Marg, Opposite Rai and Company, Civil Lines, Prayagraj, Uttar Pradesh 211001"
COMPANY_PHONE="9194085890"
COMPANY_GSTIN="09AFYFS5388G1ZX"
COMPANY_DOMAIN="www.softlabglobal.com"

# ------------------------------------------------------------------------------
# 10. SYSTEM SEEDING CREDENTIALS (Initial Bootstrapping & Local Staging)
# ------------------------------------------------------------------------------
# Email addresses for initial accounts
INITIAL_SUPER_ADMIN_EMAIL="admin@softlabglobal.com"
INITIAL_SUPER_ADMIN_NAME="Super Administrator"
SEED_TRAINER_EMAIL="trainer@softlabglobal.com"
SEED_STUDENT_EMAIL="student@softlabglobal.com"

# Seeding passwords: Required ONLY when creating new accounts via 'npm run db:seed'
# Set secure passwords in your local untracked .env file.
SEED_SUPER_ADMIN_PASSWORD="<configure-super-admin-password>"
SEED_TRAINER_PASSWORD="<configure-trainer-password>"
SEED_STUDENT_PASSWORD="<configure-student-password>"

# Explicit flag required to reset existing user passwords during 'npm run db:seed'
# Set to 'true' only when deliberately rotating seed accounts locally.
RESET_SEED_PASSWORDS="false"
