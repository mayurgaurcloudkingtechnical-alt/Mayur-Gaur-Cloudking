  ARCHIVED
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
}

enum PlacementApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SELECTED
  OFFERED
  OFFER_ACCEPTED
  OFFER_REJECTED
  JOINED
  DID_NOT_JOIN
  PLACED
  REJECTED
  WITHDRAWN
}

enum InterviewRoundType {
  APTITUDE
  TECHNICAL
  CODING
  HR
  GROUP_DISCUSSION
  MANAGERIAL
  FINAL
  OTHER
}

model CorporatePartner {
  id               String              @id @default(cuid())
  name             String
  industry         String?
  website          String?
  companySize      String?
  address          String?
  city             String?
  state            String?
  country          String?             @default("India")
  gstNumber        String?
  contactPerson    String?
  contactEmail     String?
  contactPhone     String?
  location         String?
  notes            String?             @db.Text
  lastContactDate  DateTime?
  nextFollowUpDate DateTime?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  jobDrives        JobDrive[]
  recruiters       RecruiterContact[]
  followUps        RecruiterFollowUp[]

  @@index([isActive])
  @@map("corporate_partners")
}

model RecruiterContact {
  id                     String             @id @default(cuid())
  companyId              String
  company                CorporatePartner   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  designation            String?
  email                  String
  phone                  String
  altPhone               String?
  linkedinUrl            String?
  location               String?
  preferredCommunication String?            // CALL, EMAIL, WHATSAPP, LINKEDIN
  assignedStaffId        String?
  assignedStaff          User?              @relation("RecruiterAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  notes                  String?            @db.Text
  nextFollowUpDate       DateTime?
  status                 String             @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  followUps              RecruiterFollowUp[]
  jobDrives              JobDrive[]

  @@index([companyId])
  @@index([email])
  @@map("recruiter_contacts")
}

model RecruiterFollowUp {
  id               String            @id @default(cuid())
  companyId        String
  company          CorporatePartner  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId      String?
  recruiter        RecruiterContact? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  staffId          String
  staff            User              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type             String            // CALL, EMAIL, MEETING, WHATSAPP, NOTE
  notes            String            @db.Text
  nextFollowUpDate DateTime?
  status           String            @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([companyId])
  @@index([recruiterId])
  @@index([staffId])
  @@map("recruiter_follow_ups")
}

model JobDrive {
  id                      String                 @id @default(cuid())
  companyId               String
  company                 CorporatePartner       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId             String?
  recruiter               RecruiterContact?      @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  title                   String
  slug                    String                 @unique
  department              String?
  jobType                 JobType                @default(FULL_TIME)
  workMode                String?                @default("ON_SITE") // ON_SITE, HYBRID, REMOTE
  description             String                 @db.Text
  responsibilities        String?                @db.Text
  requirements            String?                @db.Text
  benefits                String?                @db.Text
  eligibilityCriteria     String?                @db.Text
  minPassingPercentage    Float?
  minAttendancePercentage Float?                 @default(75.0)
  requireCertification    Boolean                @default(false)
  targetCourseId          String?
  targetCourse            Course?                @relation(fields: [targetCourseId], references: [id], onDelete: SetNull)
  eligibleBatchId         String?
  eligibleBatch           Batch?                 @relation(fields: [eligibleBatchId], references: [id], onDelete: SetNull)
  salaryPackage           String?                // e.g. "₹4.5 - 6.5 LPA" or "₹25,000/month"
  minSalary               Int?                   // in integer Paise
  maxSalary               Int?                   // in integer Paise
  salaryType              String?                @default("ANNUAL_CTC")
  experienceRequired      String?
  qualification           String?
  location                String?
  openingsCount           Int                    @default(1)
  requiredSkills          String[]               @default([])
  preferredSkills         String[]               @default([])
  deadline                DateTime?
  driveDate               DateTime?
  interviewDate           DateTime?
  joiningDate             DateTime?
  venue                   String?
  meetingLink             String?
  driveType               String?                @default("CAMPUS_DRIVE")
  status                  JobDriveStatus         @default(DRAFT)
  createdById             String
  createdBy               User                   @relation("JobDriveCreator", fields: [createdById], references: [id])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  applications            PlacementApplication[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([targetCourseId])
  @@index([eligibleBatchId])
  @@index([status])
  @@index([deadline])
  @@map("job_drives")
}

model StudentPlacementProfile {
  id                String         @id @default(cuid())
  studentId         String         @unique
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  headline          String?
  bio               String?        @db.Text
  resumeUrl         String?
  portfolioUrl      String?
  githubUrl         String?
  linkedinUrl       String?
  skills            String[]       @default([])
  preferredLocation String?
  preferredRole     String?
  expectedSalary    String?
  experienceMonths  Int?           @default(0)
  placementStatus   String         @default("REGISTERED") // ELIGIBLE, REGISTERED, APPLIED, SHORTLISTED, INTERVIEWING, SELECTED, OFFERED, JOINED, PLACED, OPTED_OUT
  resumeFileName    String?
  resumeUpdatedAt   DateTime?
  isPlaced          Boolean        @default(false)
  placedCompany     String?
  placedPackage     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId])
  @@index([isPlaced])
  @@index([placementStatus])
  @@map("student_placement_profiles")
}

model PlacementApplication {
  id              String                     @id @default(cuid())
  jobDriveId      String
  jobDrive        JobDrive                   @relation(fields: [jobDriveId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          PlacementApplicationStatus @default(APPLIED)
  coverNote       String?                    @db.Text
  offeredPackage  String?
  rejectionReason String?
  appliedAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  rounds          InterviewRound[]
  offer           PlacementOffer?
  joiningRecord   PlacementJoiningRecord?

  @@unique([jobDriveId, studentId])
  @@index([jobDriveId])
  @@index([studentId])
  @@index([status])
  @@map("placement_applications")
}

model InterviewRound {
  id            String               @id @default(cuid())
  applicationId String
  application   PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundNumber   Int
  roundType     InterviewRoundType
  scheduledAt   DateTime?
  meetingLink   String?
  feedback      String?              @db.Text
  passed        Boolean?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([applicationId])
  @@map("interview_rounds")
}

model PlacementOffer {
  id               String               @id @default(cuid())
  applicationId    String               @unique
  application      PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyName      String
  position         String
  ctc              Int                  // in integer Paise
  fixedSalary      Int?
  variableSalary   Int?
  joiningBonus     Int?
  workLocation     String?
  offerDate        DateTime             @default(now())
  joiningDate      DateTime?
  offerDocumentUrl String?
  status           String               @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("placement_offers")
}

model PlacementJoiningRecord {
  id                  String               @id @default(cuid())
  applicationId       String               @unique
  application         PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyName         String
  position            String
  joinedDate          DateTime             @default(now())
  employeeId          String?
  joiningProofUrl     String?
  status              String               @default("JOINED") // JOINED, PROBATION, CONFIRMED, RESIGNED, TERMINATED, DID_NOT_JOIN
  followUpDate        DateTime?
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("placement_joining_records")
}

